.app-header { background:#000c2e; }
.app-header-ai { align-items:center; display:flex; gap:10px; min-width:0; }
.app-header-ai-back { align-items:center; background:rgba(255,255,255,.1); border:0; border-radius:9px; color:#fff; display:flex; flex:none; height:32px; justify-content:center; width:32px; }
.app-header-ai-back:hover { background:rgba(255,255,255,.18); }
.app-header-ai-title { display:flex; flex-direction:column; min-width:0; }
.app-header-ai-title strong { color:#fff; font-size:13px; }
.app-header-ai-title span { color:#93a8d6; font-size:10px; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }